# Lambda NX — environment variables (copy to .env.local; never commit real secrets)

# ── Database (any Postgres: Supabase, Neon, self-host) ────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/lambda_nx

# ── Session (our own signed cookies) ──────────────────────────────────────────
# Strong random string, 16+ chars. Generate: openssl rand -base64 32
SESSION_SECRET=

# ── Scheduler: everything the platform does on its own ────────────────────────
# One secret guards every scheduled job at GET /api/cron/<job>:
#   publish | radar | radar-monitors | radar-watch
# Sent as either "Authorization: Bearer <secret>" (what Vercel Cron and most
# hosted schedulers send) or "x-cron-secret: <secret>". Also guards the older
# POST /api/radar/run.
#
# Unset ⇒ every job answers 503, which means the platform publishes nothing on
# its own and the Radar never sweeps. This is the variable to set first if the
# front page has stopped filling itself.
# Generate: openssl rand -base64 32
CRON_SECRET=

# ── Admin: private usage registry ─────────────────────────────────────────────
# Unlocks GET /api/admin/visitors (who uses the app + their country — operator
# only, never shown in the product). Unset ⇒ the endpoint is disabled (503).
# Generate: openssl rand -base64 32
ADMIN_SECRET=
# Also unlocks the publishing-channel dashboard at /admin/social.

# ── Social publishing: encryption key for stored bot tokens ───────────────────
# Channels that need a token (Telegram) store it AES-256-GCM encrypted under this
# key. Unset ⇒ those channels are refused rather than stored in plain text; the
# webhook platforms (Discord, Slack, generic) work without it. Rotating this key
# makes existing tokens unreadable — the dashboard will say so per channel.
# Generate: openssl rand -base64 32
SOCIAL_SECRET_KEY=

# ── Provider selection (isolation layers; defaults in parentheses) ────────────
AUTH_PROVIDER=pi            # pi | standalone (server-side auth provider)
PAYMENT_PROVIDER=pi         # pi | standard (Stripe)
# Client shell: 'pi' (Pi SDK gate) or 'standalone' (email/password login screen).
NEXT_PUBLIC_AUTH_MODE=pi
# Blobs (avatars) default to the database when DATABASE_URL is set, because a
# serverless filesystem is ephemeral and silently loses uploads. Override only
# for a self-hosted install with a real disk.
STORAGE_PROVIDER=          # database | filesystem (default: database when a DB is configured)
QUEUE_PROVIDER=memory       # memory (durable pgmq/pg_cron in P4)

# ── Pi Network ────────────────────────────────────────────────────────────────
# Server-side key from the Pi Developer Portal. Required for Pi payments. Secret.
PI_API_KEY=
# Override only for sandbox/testing; defaults to https://api.minepi.com
# PI_API_BASE=https://api.minepi.com

# ── Standard payments (Stripe; used when PAYMENT_PROVIDER=standard) ────────────
# Secret key from the Stripe dashboard. Server-side only, never exposed.
STRIPE_SECRET_KEY=

# ── Storage (filesystem provider) ────────────────────────────────────────────
# STORAGE_DIR=.storage

# ── Subscription tiers (single source of truth is lib/plans/plans.ts) ─────────
# Change a price without a code change by setting these (Pro monthly). Tier
# enforcement is OFF until ENFORCE_TIERS=true (subscriptions ship).
# PRICE_PRO_PI=10
# PRICE_PRO_USD=9
# ENFORCE_TIERS=false

# ── AI analyst (optional; triages/summarizes our own evidence — never verifies) ─
# Without a key the analyst returns a graceful "not configured" notice and the
# rest of the app is unaffected. It only reads evidence we already collected.
AI_PROVIDER=claude          # claude | disabled
ANTHROPIC_API_KEY=          # from console.anthropic.com; secret. Leave blank to disable.
# ANALYST_MODEL=claude-opus-5  # override the analyst model
