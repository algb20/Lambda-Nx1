# Lambda NX — environment variables (copy to .env.local; never commit real secrets)

# ── Database (any Postgres: Supabase, Neon, self-host) ────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/lambda_nx

# ── Session (our own signed cookies) ──────────────────────────────────────────
# Strong random string, 16+ chars. Generate: openssl rand -base64 32
SESSION_SECRET=

# ── Radar scheduler ───────────────────────────────────────────────────────────
# Shared secret the cron/pg_cron job sends as the x-cron-secret header to
# POST /api/radar/run. Without it, the endpoint is disabled (503).
CRON_SECRET=

# ── Provider selection (isolation layers; defaults in parentheses) ────────────
AUTH_PROVIDER=pi            # pi | standalone
PAYMENT_PROVIDER=pi         # pi | standard (Stripe)
STORAGE_PROVIDER=filesystem # filesystem (object-store at deploy)
QUEUE_PROVIDER=memory       # memory (durable pgmq/pg_cron in P4)

# ── Pi Network ────────────────────────────────────────────────────────────────
# Server-side key from the Pi Developer Portal. Required for Pi payments. Secret.
PI_API_KEY=
# Override only for sandbox/testing; defaults to https://api.minepi.com
# PI_API_BASE=https://api.minepi.com

# ── Standard payments (Stripe; used when PAYMENT_PROVIDER=standard) ────────────
# Secret key from the Stripe dashboard. Server-side only, never exposed.
STRIPE_SECRET_KEY=

# ── Storage (filesystem provider) ────────────────────────────────────────────
# STORAGE_DIR=.storage

# ── Subscription tiers (single source of truth is lib/plans/plans.ts) ─────────
# Change a price without a code change by setting these (Pro monthly). Tier
# enforcement is OFF until ENFORCE_TIERS=true (subscriptions ship).
# PRICE_PRO_PI=10
# PRICE_PRO_USD=9
# ENFORCE_TIERS=false

# ── AI analyst (optional; triages/summarizes our own evidence — never verifies) ─
# Without a key the analyst returns a graceful "not configured" notice and the
# rest of the app is unaffected. It only reads evidence we already collected.
AI_PROVIDER=claude          # claude | disabled
ANTHROPIC_API_KEY=          # from console.anthropic.com; secret. Leave blank to disable.
# ANALYST_MODEL=claude-opus-5  # override the analyst model
