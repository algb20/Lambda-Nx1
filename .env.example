# Lambda NX — environment variables (copy to .env.local; never commit real secrets)

# ── Database (any Postgres: Supabase, Neon, self-host) ────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/lambda_nx

# ── Session (our own signed cookies) ──────────────────────────────────────────
# Strong random string, 16+ chars. Generate: openssl rand -base64 32
SESSION_SECRET=

# ── Provider selection (isolation layers; defaults in parentheses) ────────────
AUTH_PROVIDER=pi            # pi (standalone in P12)
PAYMENT_PROVIDER=pi         # pi (standard/Stripe in P12)
STORAGE_PROVIDER=filesystem # filesystem (object-store at deploy)
QUEUE_PROVIDER=memory       # memory (durable pgmq/pg_cron in P4)

# ── Pi Network ────────────────────────────────────────────────────────────────
# Server-side key from the Pi Developer Portal. Required for Pi payments. Secret.
PI_API_KEY=
# Override only for sandbox/testing; defaults to https://api.minepi.com
# PI_API_BASE=https://api.minepi.com

# ── Storage (filesystem provider) ────────────────────────────────────────────
# STORAGE_DIR=.storage
